# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multi_agent_app?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760  # 10MB

# AI API (可选)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""